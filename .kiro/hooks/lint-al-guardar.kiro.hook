{
  "enabled": true,
  "name": "Lint al guardar",
  "description": "Ejecuta npm run lint al guardar un archivo .ts o .tsx dentro de src/. Deshabilitado hasta que exista package.json.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/**/*.ts", "src/**/*.tsx"]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint"
  }
}
