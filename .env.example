# Región de AWS (no empezar por AWS_ — restricción de Amplify Hosting)
APP_REGION=us-east-1

# Nombre de la tabla DynamoDB
DDB_TABLE=frankenforms-dev

# Nombre del bucket S3 (imágenes privadas)
S3_BUCKET=frankenforms-dev-uploads

# ID del inference profile de Bedrock (nunca hardcodear en el código)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
